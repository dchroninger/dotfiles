theme = dark:Catppuccin Mocha,light:Catppuccin Latte

# font
font-family = SF Mono
font-thicken = true
adjust-cell-height = 10%

# window
window-padding-x = 8
window-padding-y = 10,1
# never restore windows: every window is just `tmux attach main` so there's
# nothing worth restoring, and restoring the cmd+` quick terminal is actively
# broken in 1.3.x — the restored surface loses GHOSTTY_QUICK_TERMINAL (so it
# attaches to "main" and shrinks it to 21 rows) and its saved frame overrides
# quick-terminal-size forever (full width x 400px).
window-save-state = never
# opaque window; wallpaper is blended into the bg below, not the desktop
background-opacity = 1
# personal wallpaper, kept out of the repo. `bgroll` (shell fn) writes this file
# with a path into ~/wallpapers/terminal/pool; missing file = plain mocha bg
config-file = ?~/wallpapers/terminal/current.conf
background-image-fit = cover
# mix image w/ mocha bg so the theme dominates and the image reads as texture
background-image-opacity = 0.15

# input / clipboard
macos-option-as-alt = true
copy-on-select = clipboard
mouse-hide-while-typing = true
cursor-style-blink = false

# shell / ssh
# always land in tmux: windows attach/create "main", the cmd+` quick terminal
# gets its own "quick" session. Logic lives in the script: ghostty wraps `command`
# in `bash -c "exec -l …"`, so no inline shell syntax here.
command = ~/.config/ghostty/ghostty-shell
shell-integration-features = ssh-env,ssh-terminfo

# security
macos-auto-secure-input = true
macos-secure-input-indication = false

# updates
auto-update = download

# quick terminal (cmd+`): drops from the top, centered. 50% tall x 38% wide ≈ 700x1300px on 3440x1440.
# ghostty caches the last closed frame per screen, so changing the size needs a
# full ghostty restart (or drag-resize the quick terminal once).
quick-terminal-position = top
quick-terminal-size = 50%,38%

# keybinds
keybind = global:super+grave_accent=toggle_quick_terminal
