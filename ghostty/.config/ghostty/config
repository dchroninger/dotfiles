theme = dark:Catppuccin Mocha,light:Catppuccin Latte

# font
font-family = SF Mono
font-thicken = true
adjust-cell-height = 10%

# window
window-padding-x = 8
window-padding-y = 10,1
window-save-state = always
# opaque window; wallpaper is blended into the bg below, not the desktop
background-opacity = 1
# personal wallpaper, kept out of the repo; falls back to plain bg if missing.
# extensionless on purpose: ghostty sniffs PNG/JPEG magic bytes, so any format works
background-image = ~/wallpapers/terminal/bg
background-image-fit = cover
# mix image w/ mocha bg so the theme dominates and the image reads as texture
background-image-opacity = 0.15

# input / clipboard
macos-option-as-alt = true
copy-on-select = clipboard
mouse-hide-while-typing = true
cursor-style-blink = false

# shell / ssh
shell-integration-features = ssh-env,ssh-terminfo

# security
macos-auto-secure-input = true
macos-secure-input-indication = false

# updates
auto-update = download

# keybinds
keybind = global:super+grave_accent=toggle_quick_terminal
